@implements IAsyncDisposable
@inject IJSRuntime JS

@* Three blinds side by side: drag each window down to lower its blind. Positions run 0 (up) to 3 (down). *@

<div class="sheet-backdrop" @onclick="Close">
    <section class="sheet material" role="dialog" aria-label="阳台窗帘" @onclick:stopPropagation="true">
        <header class="sheet__head">
            <span class="widget__icon" style="--accent: var(--blue)"><BlindsIcon/></span>
            <div class="sheet__title">
                阳台窗帘
                <small>上下拖动每一片窗帘</small>
            </div>
            <button class="sheet__close pressable" aria-label="关闭" @onclick="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </header>
        <div class="sheet__body">
            <div class="blinds">
                @for (var i = 0; i < 3; i++)
                {
                    var index = i;
                    var value = Fraction(index);
                    var target = Target(index);
                    var style = target is { } t
                        ? $"--value: {Format.Invariant(value)}; --target: {Format.Invariant(t)}"
                        : $"--value: {Format.Invariant(value)}";
                    <div class="blind">
                        <div class="blind__label">
                            @(index + 1)<small data-percent>@Format.BlindsState(value)</small>
                        </div>
                        <div class="blind__track" @ref="_tracks[index]" style="@style">
                            @if (target is not null)
                            {
                                <div class="blind__ghost"></div>
                            }
                            <div class="blind__fabric"></div>
                            @if (target is not null)
                            {
                                <div class="blind__target"></div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="sheet__side">
                <button class="gbtn pressable" @onclick="() => MoveAll(0)">
                    <i class="fa-solid fa-angles-up"></i>全部打开
                </button>
                <button class="gbtn pressable" @onclick="() => MoveAll(1)">
                    <i class="fa-solid fa-angles-down"></i>全部关闭
                </button>
                <button class="gbtn pressable" @onclick="Stop">
                    <i class="fa-solid fa-stop"></i>停止
                </button>
                <button class="gbtn pressable" style="margin-top: auto; min-height: 44px; font-size: 14px" @onclick="Calibrate">
                    <i class="fa-solid fa-ruler-vertical"></i>校准位置
                </button>
            </div>
        </div>
    </section>
</div>

@code {
    private static readonly TimeSpan TargetTimeout = TimeSpan.FromSeconds(45);

    [CascadingParameter] public DashboardUi Ui { get; set; } = null!;

    [Parameter, EditorRequired] public BlindsInfo Blinds { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }

    private readonly ElementReference[] _tracks = new ElementReference[3];
    private readonly (double Fraction, DateTime SetAt)?[] _targets = new (double, DateTime)?[3];
    private DotNetObjectReference<BlindsSheet>? _self;
    private IJSObjectReference? _module;

    private double Fraction(int index) => Blinds.Positions.ElementAtOrDefault(index) / BlindsInfo.Closed;

    /// <summary>Where a blind was sent, until it gets there or gives up.</summary>
    private double? Target(int index)
    {
        if (_targets[index] is not { } target)
        {
            return null;
        }

        if (Math.Abs(Fraction(index) - target.Fraction) < .04 || DateTime.UtcNow - target.SetAt > TargetTimeout)
        {
            _targets[index] = null;
            return null;
        }

        return target.Fraction;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
            for (var i = 0; i < _tracks.Length; i++)
            {
                await _module.InvokeVoidAsync("initBlind", _tracks[i], _self, i);
            }
        }
        catch (JSDisconnectedException)
        {
            // The sheet closed with the circuit.
        }
    }

    [JSInvokable]
    public Task OnBlindReleased(int index, double fraction)
    {
        fraction = Math.Clamp(fraction, 0, 1);
        _targets[index] = (fraction, DateTime.UtcNow);
        Ui.Run(a => a.MoveBlinds([index], fraction * BlindsInfo.Closed));
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void MoveAll(double fraction)
    {
        for (var i = 0; i < _targets.Length; i++)
        {
            _targets[i] = (fraction, DateTime.UtcNow);
        }

        Ui.Run(a => a.MoveBlinds([0, 1, 2], fraction * BlindsInfo.Closed));
    }

    private void Stop()
    {
        Array.Clear(_targets);
        Ui.Run(a => a.StopBlinds());
    }

    private void Calibrate() => Ui.Run(a => a.CalibrateBlinds());

    private Task Close() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone.
            }
        }
    }
}
