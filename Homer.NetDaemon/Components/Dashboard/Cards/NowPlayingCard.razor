@{
    var media = Home.Media!;
}

<WidgetCard Model="Card" Title="@(media.App ?? "正在播放")" Icon="fa-music" Accent="var(--pink)">
    <div class="hrow" style="gap: 14px; @(IsLarge ? "flex-direction: column; align-items: flex-start" : "")">
        <div class="artwork"><i class="fa-solid fa-music"></i></div>
        <div class="grow" style="width: 100%">
            <div class="headline ellipsis">@media.Title</div>
            @if (media.Artist is not null)
            {
                <div class="sub ellipsis">@media.Artist</div>
            }
        </div>
    </div>
    <div class="actions" style="align-items: center">
        <button class="rbtn primary pressable" aria-label="@(media.IsPlaying ? "暂停" : "播放")" @onclick="PlayPause">
            <i class="fa-solid @(media.IsPlaying ? "fa-pause" : "fa-play")"></i>
        </button>
        <button class="rbtn pressable" aria-label="下一首" @onclick="Next">
            <i class="fa-solid fa-forward"></i>
        </button>
    </div>
</WidgetCard>

@code {
    private void PlayPause() => Ui.Run(a => a.MediaPlayPause(Home.Media!.EntityId));

    private void Next() => Ui.Run(a => a.MediaNext(Home.Media!.EntityId));
}
