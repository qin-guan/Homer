<GlassCard Model="Card" Centered="true" Title="除湿机" Icon="fa-droplet" Accent="var(--sky)">
    @if (IsLarge)
    {
        <i class="glyph fa-solid fa-droplet"></i>
    }
    <div class="headline">水箱满了</div>
    <div class="sub">
        倒水后重新开机@(Home.DehumidifierTankFullAt is { } at && !IsSmall ? $" · {Format.Ago(at, Ui.Now)}" : "")
    </div>
</GlassCard>
