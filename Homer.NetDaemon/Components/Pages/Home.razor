@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Homer.NetDaemon.Components.Dashboard
@using Homer.NetDaemon.Dashboard
@using Homer.NetDaemon.Options
@using Microsoft.Extensions.Options
@inject DashboardState State
@inject DashboardActions Actions
@inject IJSRuntime JS
@inject IOptions<GoogleHomeDashboardOptions> DashboardOptions
@inject IWebHostEnvironment HostEnvironment
@inject ILogger<Home> Logger

<PageTitle>Homer</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Assets["css/home.css"]"/>
    <meta name="color-scheme" content="light dark">
</HeadContent>

@if (!Authorized)
{
    <span class="p-2">Nothing here!</span>
}
else
{
    <div class="home @AppearanceFor(_view?.Home)" data-glass="@(Glass == "lite" ? "lite" : "full")">
        @if (_view is not { } view)
        {
            <div class="connecting material">正在连接 Home Assistant…</div>
        }
        else
        {
            <CascadingValue Value="_ui" IsFixed="true">
                <div class="home-grid">
                    <HomeHero Home="view.Home"/>

                    <div class="stack-wrap">
                        <section class="stack" @ref="_stack" aria-label="智能卡片">
                            @foreach (var page in view.Pages)
                            {
                                <div class="stack__page">
                                    @foreach (var card in page.Cards)
                                    {
                                        <CardHost @key="card.Key" Card="card" Home="view.Home"/>
                                    }
                                </div>
                            }
                        </section>
                        @if (view.Pages.Count > 1)
                        {
                            <div class="stack__dots" aria-hidden="true">
                                @for (var i = 0; i < view.Pages.Count; i++)
                                {
                                    <span class="dot @(i == 0 ? "is-active" : "")"></span>
                                }
                            </div>
                        }
                    </div>

                    <HomeDock Home="view.Home" Pending="_pending.Keys" OnPress="Press"/>
                </div>

                @if (_sheet == DashboardSheet.Blinds)
                {
                    <BlindsSheet Blinds="view.Home.Blinds" OnClose="CloseSheet"/>
                }
                else if (_sheet == DashboardSheet.WaterHeater)
                {
                    <WaterHeaterSheet Heater="view.Home.WaterHeater" OnClose="CloseSheet"/>
                }
            </CascadingValue>
        }

        <div id="components-reconnect-modal" class="material">
            <i class="fa-solid fa-wifi"></i>连接中断，正在重新连接…
        </div>
    </div>
}

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan PendingTimeout = TimeSpan.FromSeconds(6);
    private static readonly TimeSpan SheetIdleTimeout = TimeSpan.FromMinutes(2);

    [SupplyParameterFromQuery] private string? Secret { get; set; }

    /// <summary>Development only: render a sample home instead of the live one, such as ?demo=evening.</summary>
    [SupplyParameterFromQuery] private string? Demo { get; set; }

    /// <summary>?glass=lite turns off the live blur for screens that can't keep up with it.</summary>
    [SupplyParameterFromQuery] private string? Glass { get; set; }

    private DashboardUi _ui = null!;
    private DashboardView? _view;
    private DashboardSheet _sheet;
    private DateTime _lastInteractionUtc = DateTime.UtcNow;
    private readonly Dictionary<string, (bool WasOn, DateTime AtUtc)> _pending = [];
    private ElementReference _stack;
    private bool _stackReady;
    private IJSObjectReference? _module;
    private IDisposable? _viewer;
    private System.Threading.Timer? _refresh;

    private bool Authorized => DashboardOptions.Value.Secret == Secret;

    private bool IsDemo => HostEnvironment.IsDevelopment() && !string.IsNullOrEmpty(Demo);

    protected override void OnInitialized()
    {
        _ui = new DashboardUi(Actions, Logger, IsDemo, () => IsDemo && _view is not null ? _view.Home.Now : DateTime.Now,
            OpenSheet, () => _lastInteractionUtc = DateTime.UtcNow);

        if (!Authorized)
        {
            return;
        }

        if (IsDemo)
        {
            _view = DemoScenarios.View(Demo!);
            return;
        }

        _view = State.Current;
        if (RendererInfo.IsInteractive)
        {
            State.Changed += OnStateChanged;
            _viewer = State.AddViewer();
            _refresh = new System.Threading.Timer(_ => InvokeAsync(OnRefresh), null, RefreshInterval, RefreshInterval);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive || !Authorized)
        {
            return;
        }

        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dashboard.js");
                await _module.InvokeVoidAsync("start");
            }

            if (_module is not null && _view is not null && !_stackReady)
            {
                _stackReady = true;
                await _module.InvokeVoidAsync("initStack", _stack);
            }
        }
        catch (JSDisconnectedException)
        {
            // The hub navigated away or reloaded mid-render.
        }
    }

    private void OnStateChanged() => _ = InvokeAsync(() =>
    {
        _view = State.Current;
        ResolvePending();
        StateHasChanged();
    });

    private void OnRefresh()
    {
        ResolvePending();
        if (_sheet != DashboardSheet.None && DateTime.UtcNow - _lastInteractionUtc > SheetIdleTimeout)
        {
            _sheet = DashboardSheet.None;
        }

        StateHasChanged();
    }

    /// <summary>A tapped tile pulses until Home Assistant reports the new state, or gives up after a few seconds.</summary>
    private void ResolvePending()
    {
        if (_view is null)
        {
            return;
        }

        foreach (var (key, pending) in _pending.ToList())
        {
            var toggle = _view.Home.QuickToggles.FirstOrDefault(t => t.Key == key);
            if (toggle is null || toggle.On != pending.WasOn || DateTime.UtcNow - pending.AtUtc > PendingTimeout)
            {
                _pending.Remove(key);
            }
        }
    }

    private void Press(QuickToggle toggle)
    {
        switch (toggle.Kind)
        {
            case QuickToggleKind.Blinds:
                OpenSheet(DashboardSheet.Blinds);
                break;
            case QuickToggleKind.WaterHeater:
                OpenSheet(DashboardSheet.WaterHeater);
                break;
            default:
                _pending[toggle.Key] = (toggle.On, DateTime.UtcNow);
                _ui.Run(a => a.Toggle(toggle.Key));
                break;
        }
    }

    private void OpenSheet(DashboardSheet sheet)
    {
        _sheet = sheet;
        _lastInteractionUtc = DateTime.UtcNow;
        StateHasChanged();
    }

    private void CloseSheet() => _sheet = DashboardSheet.None;

    /// <summary>
    /// Light by day and dark from dusk, like the Automatic appearance: the hub has no appearance setting of its own.
    /// A browser that prefers dark gets dark regardless, through the stylesheet. Dimmed further after midnight.
    /// </summary>
    private static string AppearanceFor(HomeSnapshot? home) => home?.Phase switch
    {
        null => "",
        DayPhase.LateNight => "dark late-night",
        DayPhase.Dusk or DayPhase.Night => "dark",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        State.Changed -= OnStateChanged;
        _viewer?.Dispose();
        if (_refresh is not null)
        {
            await _refresh.DisposeAsync();
        }

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone.
            }
        }
    }
}
